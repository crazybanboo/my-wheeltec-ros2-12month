<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="AttemptBackUp">
            <ClearEntireCostmap name="ClearLocal-BeforeBackUp" service_name="local_costmap/clear_entirely_local_costmap"/>
            <BackUp backup_dist="0.3" backup_speed="0.1"/>
          </Sequence>

          <Sequence name="AttemptLeftStrafing">
            <ClearEntireCostmap name="ClearLocal-BeforeLeft" service_name="local_costmap/clear_entirely_local_costmap"/>
            <DriveOnHeading dist_to_travel="0.3" speed="0.1" time_allowance="6.0"/> 
          </Sequence>

          <Sequence name="AttemptRightStrafing">
            <ClearEntireCostmap name="ClearLocal-BeforeRight" service_name="local_costmap/clear_entirely_local_costmap"/>
            <DriveOnHeading dist_to_travel="0.3" speed="0.1" time_allowance="6.0"/>
          </Sequence>

          <Sequence name="AttemptSpin">
            <ClearEntireCostmap name="ClearLocal-BeforeSpin" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Spin spin_dist="1.57"/>
          </Sequence>

          <Wait wait_duration="2"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>